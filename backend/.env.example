# Environment of the Go backend. Copy to .env for Docker Compose; the binary
# itself reads variables from the process environment only.
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rag_movie_picker?sslmode=disable
PG_MAX_CONNS=10
ALLOWED_ORIGIN=http://127.0.0.1:8080
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
COOKIE_SECURE=false
REGISTRATION_ENABLED=false
ARGON2_ITERATIONS=3
ARGON2_MEMORY_MIB=64
ARGON2_PARALLELISM=2
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_REFRESH_PER_MINUTE=60
# Optional: without REDIS_ADDR the cache is in-memory.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=1
RAG_GRPC_ADDR=127.0.0.1:50051
RAG_TIMEOUT_SECONDS=30

# docker compose (backend/.env): container addresses, not the local ones above.
HTTP_PORT=8080
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
REDIS_ADDR_CONTAINER=redis:6379
RAG_GRPC_ADDR_CONTAINER=host.docker.internal:50051
