GRPC_ADDR=127.0.0.1:50051
QDRANT_URL=http://127.0.0.1:6333
# For local embedded Qdrant instead of a server:
# QDRANT_PATH=.qdrant
QDRANT_COLLECTION=movies_v1
INDEX_STATE_DIR=.state
DATASET_PATH="../../TMDB 5000 Movie Dataset/tmdb_5000_movies.csv"
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
RETRIEVAL_STRATEGY=hybrid
DEFAULT_RESULTS=10
MAX_RESULTS=50
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=4096
# Conservative UTF-8 input budget, not an exact token count:
LLM_CONTEXT_BYTES=24000
